# Blind annotator (Claude) — cross-family from the GPT-authored calls
ANTHROPIC_API_KEY=
VE_ANNOTATOR_MODEL=claude-sonnet-4-6

# Semantic match judge (GPT) — never the same model that made the prediction
OPENAI_API_KEY=
VE_JUDGE_MODEL=gpt-5.4-mini

# Source of generator exports (transcripts + ground_truth live here)
VE_EXPORTS_DIR=../support-call-generator/exports/latest

# Early-window size in turns ("first 60-90 seconds" proxy)
VE_EARLY_TURNS=6
